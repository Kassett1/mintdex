{% extends 'base.html.twig' %}

{% block title %}Hello CardPageController!
{% endblock %}

{% block body %}

	<div>
	
		<p>{{card.name}}</p>
		<img src="{{card.image}}/low.webp" alt="{{card.name}}">
	</div>

	<form data-controller="add-card" data-add-card-target="form" data-action="submit->add-card#sendData">
		<input type="hidden" name="cardId" value="{{ card.id }}">

		<label class="block text-sm">État :</label>
		<select name="cardCondition" class="text-sm">
			<option value="mt">Mint</option>
			<option value="nm" selected>Near Mint</option>
			<option value="ex">Excellent</option>
			<option value="gd">Good</option>
			<option value="lp">Light Played</option>
			<option value="pl">Played</option>
			<option value="po">Poor</option>
		</select>

		<button type="submit" class="mt-1 text-sm bg-orange-300 rounded px-2">
			Ajouter
		</button>
	</form>

	{% if cards %}
		<ul  data-controller="remove-card">
			{% for c in cards %}
				<li>
					<p>{{c.getCard().getName()}}</p>
					<p>{{c.getCardCondition()}}</p>
					<button class="w-8 h-8" data-action="click->remove-card#removeCard" data-card-id="{{ c.getId() }}">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
							<path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
						</svg>
					</button>
				</li>
			{% endfor %}
		</ul>
	{% endif %}
{% endblock %}
