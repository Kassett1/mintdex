{% extends 'base.html.twig' %}

{% block title %}Hello CardPageController!
{% endblock %}

{% block body %}
	<section data-controller="add-card wishlist">

		<div
			class="max-w-md mx-auto p-4 bg-white rounded shadow-md flex flex-col items-center gap-5">
			<!-- Carte principale -->
			<div class="text-center">
				<p class="text-xl font-semibold mb-2">{{ card.name }}</p>
				<img src="{{ card.image }}/low.webp" alt="{{ card.name }}" class="mx-auto w-48 h-auto">
			</div>

			<button class="w-8 h-8 rounded flex items-center justify-center transition
													       {{ card.id in wishlistCards ? 'bg-red-500' : ' bg-pink-300' }}" data-action="click->wishlist#toggle" data-wishlist-card-id="{{ card.id }}" data-wishlist-initial-value="{{ card.id in wishlistCards ? 'true' : 'false' }}">
				<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="{{ card.id in wishlistCards ? 'currentColor' : 'none' }}" class="w-5 h-5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/>
				</svg>
			</button>

			<!-- Formulaire d'ajout -->
			{% if app.user %}
				<form data-add-card-target="form" data-action="submit->add-card#sendData" class="p-4 bg-gray-50 rounded border w-sm" data-hidden="false" data-add-to-list="true">
					<input type="hidden" name="cardId" value="{{ card.id }}">

					<label class="block text-sm font-medium mb-1">État :</label>
					<select name="cardCondition" class="w-full mb-2 px-2 py-1 border rounded text-sm">
						<option value="mt">Mint</option>
						<option value="nm" selected>Near Mint</option>
						<option value="ex">Excellent</option>
						<option value="gd">Good</option>
						<option value="lp">Light Played</option>
						<option value="pl">Played</option>
						<option value="po">Poor</option>
					</select>

					<button type="submit" class="w-full mt-2 text-sm bg-orange-300 hover:bg-orange-400 rounded px-2 py-1 transition">
						Ajouter
					</button>
				</form>
			{% endif %}

			<!-- Liste des cartes -->

			<ul data-controller="remove-card" class="space-y-2" data-add-card-target="cardList">
				{% if cards %}
					{% for card in cards %}
						<li class="flex items-center justify-between p-2 bg-gray-100 rounded border w-sm">
							<div>
								<p class="font-medium">{{ card.getCard().getName() }}</p>
								<p class="text-sm text-gray-600">{{ card.getCardCondition() }}</p>
							</div>
							<button class="w-8 h-8 text-red-500 hover:text-red-700" data-action="click->remove-card#removeCard" data-card-id="{{ card.getId() }}">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
									<path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
								</svg>
							</button>
						</li>
					{% endfor %}
				{% endif %}
			</ul>

		</div>
	</section>

{% endblock %}
