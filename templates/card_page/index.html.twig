{% extends 'base.html.twig' %}

{% block title %}Hello CardPageController!
{% endblock %}

{% block body %}
	<section data-controller="add-card wishlist" data-add-card-update-button-value="false">

		<div
			class="flex flex-col items-center gap-5 mt-10 mx-5">
			<!-- Carte principale -->
			<div class="text-center">
				<h2 class="font-bricolage text-lg mb-2">{{ card.name }}</h2>
				<img src="{{ card.image }}/low.webp" alt="{{ card.name }}" class="mx-auto w-48 h-auto">
			</div>

			{% if app.user %}
				<div class="flex flex-col justify-center items-center gap-2">
					<div class="flex gap-3">
						<button class="w-6 h-6 rounded flex items-center justify-center transition {{ card.id in wishlistCards ? 'bg-pink-500/50' : 'bg-indigo-900/50' }} backdrop-blur-sm text-white shadow-md" data-action="click->wishlist#toggle" data-wishlist-card-id="{{ card.id }}" data-wishlist-initial-value="{{ card.id in wishlistCards ? 'true' : 'false' }}">
							<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="{{ card.id in wishlistCards ? 'currentColor' : 'none' }}" class="w-5 h-5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/>
							</svg>
						</button>

						<!-- Bouton -->
						<button type="button" data-action="click->add-card#toggle" class="w-6 h-6 rounded flex items-center justify-center transition backdrop-blur-sm text-white shadow-md bg-orange-500/50" data-add-card-target="button">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
							</svg>
						</button>

						<button class="rounded flex bg-violet-950/40 backdrop-blur-sm text-white shadow-md text-xs font-inter px-2 py-1">
							{{ card.getPrice() }}€
						</button>

						<button class="flex gap-1 rounded bg-violet-950/40 backdrop-blur-sm text-white shadow-md px-2 py-1">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 0 0-5.78 1.128 2.25 2.25 0 0 1-2.4 2.245 4.5 4.5 0 0 0 8.4-2.245c0-.399-.078-.78-.22-1.128Zm0 0a15.998 15.998 0 0 0 3.388-1.62m-5.043-.025a15.994 15.994 0 0 1 1.622-3.395m3.42 3.42a15.995 15.995 0 0 0 4.764-4.648l3.876-5.814a1.151 1.151 0 0 0-1.597-1.597L14.146 6.32a15.996 15.996 0 0 0-4.649 4.763m3.42 3.42a6.776 6.776 0 0 0-3.42-3.42"/>
							</svg>
							<p class="text-xs font-inter">{{ card.getIllustrator() }}</p>
						</button>
					</div>
				</div>

				<!-- Popup -->
				<form data-add-card-target="form" data-action="submit->add-card#sendData" class="hidden fixed bottom-0 left-1/2 -translate-x-1/2 w-[calc(100%-20px)] bg-indigo-950/40 backdrop-blur-lg rounded-t-xl shadow-md p-4 translate-y-full transition-transform duration-300 ease-out z-50">

					<input
					type="hidden" name="cardId" value="{{ card.id }}">

					<!-- État -->
					<label class="block text-sm font-inter mb-1">
						État
						<span class="text-red-400">*</span>
					</label>
					<select name="cardCondition" required class="text-sm font-inter w-full mb-3 p-1 rounded">
						<option value="mt">Mint</option>
						<option value="nm" selected>Near Mint</option>
						<option value="ex">Excellent</option>
						<option value="gd">Good</option>
						<option value="lp">Light Played</option>
						<option value="pl">Played</option>
						<option value="po">Poor</option>
					</select>

					<!-- Langue -->
					<label class="block text-sm font-inter mb-1">
						Langue
						<span class="text-red-400">*</span>
					</label>
					<select name="language" required class="text-sm font-inter w-full mb-3 p-1 rounded">
						<option value="fr">🇫🇷 Français</option>
						<option value="en">🇬🇧 Anglais</option>
						<option value="de">🇩🇪 Allemand</option>
						<option value="es">🇪🇸 Espagnol</option>
						<option value="it">🇮🇹 Italien</option>
						<option value="pt">🇵🇹 Portugais</option>
					</select>

					<!-- Version -->
					<label class="block text-sm font-inter mb-1">
						Version
						<span class="text-red-400">*</span>
					</label>
					<select name="version" required class="text-sm font-inter w-full mb-3 p-1 rounded">
						<option value="normal">Normale</option>
						<option value="reverse">Reverse</option>
						<option value="holo">Holo</option>
						<option value="first">1ère édition</option>
					</select>

					<!-- Estimation (optionnel) -->
					<label class="block text-sm font-inter mb-1">
						Estimation
					</label>
					<input type="text" id="price" name="price" placeholder="{{ card.getPrice() }}" class="text-sm font-inter w-full mb-3 p-1 rounded"/>

					<button type="submit" class="w-full bg-orange-300 hover:bg-orange-400 text-sm rounded py-2 transition">
						Ajouter
					</button>
				</form>
			{% endif %}

			<div class="flex flex-col gap-2 items-center w-full bg-white shadow-sm rounded-xl p-2">
				<a class="bg-violet-200 backdrop-blur-lg rounded-xl border border-violet-200 shadow-sm px-2 py-1 text-violet-900 font-sora text-sm w-full text-center">Voir sur eBay (non disponible)</a>
				<a class="bg-violet-200 backdrop-blur-lg rounded-xl border border-violet-200 shadow-sm px-2 py-1 text-violet-900 font-sora text-sm w-full text-center" href="{{cardmarketLink}}">Voir sur Cardmarket</a>
				<a class="bg-violet-200 backdrop-blur-lg rounded-xl border border-violet-200 shadow-sm px-2 py-1 text-violet-900 font-sora text-sm w-full text-center" href="{{vintedLink}}">Voir sur Vinted</a>
			</div>

			<!-- Liste des cartes -->
			<ul data-controller="remove-card" class="w-full p-2 flex flex-col gap-2" data-add-card-target="cardList">
				{% if cards %}
					{% for card in cards %}
						<li class="flex items-center justify-between w-full rounded-xl px-3 py-1 bg-white shadow-sm">
							<div>
								<p class="font-medium">{{ card.getCard().getName() }}</p>
								<p class="text-sm text-gray-600">{{ card.getCardCondition() }}</p>
							</div>
							<button class="text-red-500 hover:text-red-700" data-action="click->remove-card#removeCard" data-card-id="{{ card.getId() }}">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
									<path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
								</svg>
							</button>
						</li>
					{% endfor %}
				{% endif %}
			</ul>

		</section>
	</div>
{% endblock %}
