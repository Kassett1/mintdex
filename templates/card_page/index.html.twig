{% extends 'base.html.twig' %}

{% block title %}Hello CardPageController!
{% endblock %}

{% block body %}
	<section data-controller="add-card wishlist">

		<div
			class="flex flex-col items-center gap-5 mt-10 mx-5">
			<!-- Carte principale -->
			<div class="text-center">
				<h2 class="font-bricolage text-lg mb-2">{{ card.name }}</h2>
				<img src="{{ card.image }}/low.webp" alt="{{ card.name }}" class="mx-auto w-48 h-auto">
			</div>

			{% if app.user %}
				<div class="flex gap-5">
					<button class="w-6 h-6 rounded flex items-center justify-center transition {{ card.id in wishlistCards ? 'bg-pink-500/30' : 'bg-indigo-900/30' }} backdrop-blur-sm text-white shadow-md" data-action="click->wishlist#toggle" data-wishlist-card-id="{{ card.id }}" data-wishlist-initial-value="{{ card.id in wishlistCards ? 'true' : 'false' }}">
						<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="{{ card.id in wishlistCards ? 'currentColor' : 'none' }}" class="w-5 h-5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/>
						</svg>
					</button>

					<!-- Bouton -->
					<button type="button" data-action="click->add-card#toggle" class="w-6 h-6 rounded flex items-center justify-center transition backdrop-blur-sm text-white shadow-md bg-orange-500/30" data-add-card-target="button">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
						</svg>
					</button>

				</div>

				<!-- Popup -->
				<form data-add-card-target="form" data-action="submit->add-card#sendData" class="hidden fixed bottom-0 left-1/2 -translate-x-1/2 w-[calc(100%-20px)]
																																																	               bg-indigo-950/40 backdrop-blur-lg rounded-t-xl shadow-md p-4
																																																	               translate-y-full transition-transform duration-300 ease-out z-50">
					<input type="hidden" name="cardId" value="{{ card.id }}">

					<label class="block text-sm font-inter mb-1">État :</label>
					<select name="cardCondition" class="text-sm font-inter w-full mb-3 p-1 rounded">
						<option value="mt">Mint</option>
						<option value="nm" selected>Near Mint</option>
						<option value="ex">Excellent</option>
						<option value="gd">Good</option>
						<option value="lp">Light Played</option>
						<option value="pl">Played</option>
						<option value="po">Poor</option>
					</select>

					<button type="submit" class="w-full bg-orange-300 hover:bg-orange-400 text-sm rounded py-2 transition">
						Ajouter
					</button>
				</form>
			{% endif %}

			<div class="flex flex-col gap-2 items-center w-full">
				<a class="bg-violet-200 backdrop-blur-lg rounded-xl border border-violet-200 shadow-sm px-2 py-1 text-violet-900 font-sora text-sm w-full text-center">Voir sur eBay (non disponible actuellement)</a>
				<a class="bg-violet-200 backdrop-blur-lg rounded-xl border border-violet-200 shadow-sm px-2 py-1 text-violet-900 font-sora text-sm w-full text-center" href="{{cardmarketLink}}">Voir sur Cardmarket</a>
				<a class="bg-violet-200 backdrop-blur-lg rounded-xl border border-violet-200 shadow-sm px-2 py-1 text-violet-900 font-sora text-sm w-full text-center" href="{{vintedLink}}">Voir sur Vinted</a>
			</div>

			<!-- Liste des cartes -->

			<ul data-controller="remove-card" class="space-y-2" data-add-card-target="cardList">
				{% if cards %}
					{% for card in cards %}
						<li class="flex items-center justify-between p-2 bg-gray-100 rounded border w-sm">
							<div>
								<p class="font-medium">{{ card.getCard().getName() }}</p>
								<p class="text-sm text-gray-600">{{ card.getCardCondition() }}</p>
							</div>
							<button class="w-8 h-8 text-red-500 hover:text-red-700" data-action="click->remove-card#removeCard" data-card-id="{{ card.getId() }}">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
									<path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
								</svg>
							</button>
						</li>
					{% endfor %}
				{% endif %}
			</ul>

		</section>
	</div>
{% endblock %}
