<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		{% block stylesheets %}
			{{ encore_entry_link_tags('app') }}
		{% endblock %}

		{% block javascripts %}
			{{ encore_entry_script_tags('app') }}
		{% endblock %}
	</head>
	<body class="bg-indigo-50">
		<nav class="sticky top-5 mx-5 z-10" data-controller="menu">
			<div class="flex items-center justify-between py-2 px-5
													bg-indigo-950/40 backdrop-blur-lg
													rounded-xl shadow-md">

				<a href="{{ path('app_home') }}" class="inline-block">
					<img src="{{ asset('images/logo_mintdex.webp') }}" alt="Mintdex" class="w-8 h-8 md:w-15 md:h-15">
				</a>

				<div class="hidden md:flex space-x-6">
					<a href="{{ path('app_register') }}">Register</a>
					<a href="{{ path('app_login') }}">Login</a>
				</div>

				<!-- Burger mobile -->
				<button class="md:hidden nav-icon relative w-6 h-6" data-action="click->menu#toggle" aria-label="Menu" aria-expanded="false">
					<span class="bg-white"></span>
					<span class="bg-white"></span>
					<span class="bg-white"></span>
					<span class="bg-white"></span>
				</button>
			</div>

			<div data-menu-target="menu" class="md:hidden absolute w-full px-3 py-2 mt-1
					           bg-indigo-950/40 backdrop-blur-lg
					           rounded-xl shadow-md
					           opacity-0 scale-95 -translate-y-2
					           pointer-events-none
					           transition-all duration-300 ease-out">

				<div class="flex flex-col gap-2">
					<a href="{{ path('app_register') }}" class="text-white font-sora text-base">
						Register
					</a>
					<a href="{{ path('app_login') }}" class="text-white font-sora text-base ">
						Login
					</a>
				</div>
			</div>
		</nav>

		{% block body %}{% endblock %}
	</body>
</html></body></html>
