								<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
							</svg>
						</a>
					{% else %}
						<div class="md:flex gap-3">
							<a href="{{ path('app_register') }}" class="text-white font-sora text-base">Register</a>
							<a href="{{ path('app_login') }}" class="text-white font-sora text-base">Login</a>
						</div>
					{% endif %}
				</div>

				<h2 class="font-bricolage text-lg text-white md:hidden">{{page}}</h2>

				<!-- Burger mobile -->
				<button class="md:hidden nav-icon relative w-6 h-6" data-action="click->menu#toggle" aria-label="Menu" aria-expanded="false">
					<span class="bg-white"></span>
					<span class="bg-white"></span>
					<span class="bg-white"></span>
					<span class="bg-white"></span>
				</button>
			</div>

			<div data-menu-target="menu" class="md:hidden absolute w-full px-3 py-2 mt-1 bg-violet-950/40 backdrop-blur-lg rounded-xl shadow-md opacity-0 scale-95 -translate-y-2 pointer-events-none transition-all duration-300 ease-out">

				<div class="flex flex-col gap-2 justify-center items-center">
					{% if app.user %}
						<a href="{{ path('app_wishlist_page') }}" class="text-white font-sora text-base">Wishlist</a>
						<a href="{{ path('app_settings') }}" class="inline-block">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-violet-50">
