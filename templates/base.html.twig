								<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
							</svg>
						</a>
					{% else %}
						<div class="flex flex-col gap-1 justify-center items-center">
							<a href="{{ path('app_register') }}" class="text-white font-sora text-base">Register</a>
							<a href="{{ path('app_login') }}" class="text-white font-sora text-base">Login</a>
						</div>
					{% endif %}
				</div>
			</div>
		</nav>

		{% block body %}{% endblock %}
	</body>
</html></body></html>
