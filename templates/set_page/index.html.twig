{% extends 'base.html.twig' %}

{% block title %}Hello SetPageController!
{% endblock %}

{% block body %}
	<div data-controller="add-card wishlist">
		<ul class="flex flex-row flex-wrap m-10 gap-5 justify-center">
			{% for card in cards %}
				<li class="w-50 relative">
					<a href="{{ path('app_card_page', { slug: card.slug }) }}">
						<img class="w-full" src="{{ card.image }}/low.webp" alt="{{ card.name }}">
					</a>

					{% if app.user %}
						<div class="flex absolute bottom-0 z-10 justify-between w-full items-end">
							<button class="w-8 h-8 rounded flex items-center justify-center transition 
									       {{ card.id in wishlistCards ? 'bg-red-500' : ' bg-pink-300' }}" data-action="click->wishlist#toggle" data-wishlist-card-id="{{ card.id }}" data-wishlist-initial-value="{{ card.id in wishlistCards ? 'true' : 'false' }}">
								<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="{{ card.id in wishlistCards ? 'currentColor' : 'none' }}" class="w-5 h-5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/>
								</svg>
							</button>
							<div>
								{% if card.id in ownedCards %}
									<button class="w-8 h-8 bg-green-300 rounded flex items-center justify-center" data-action="click->add-card#toggle">
										<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full">
											<path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
										</svg>
									</button>
								{% else %}
									<button class="w-8 h-8 bg-orange-300 rounded flex items-center justify-center" data-action="click->add-card#toggle">
										<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full">
											<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
										</svg>
									</button>
								{% endif %}

								<form data-add-card-target="form" data-action="submit->add-card#sendData" class="hidden absolute bottom-10 right-1 bg-white p-2 rounded shadow" data-hidden="true" data-add-to-list="false">
									<input type="hidden" name="cardId" value="{{ card.id }}">

									<label class="block text-sm">État :</label>
									<select name="cardCondition" class="text-sm">
										<option value="mt">Mint</option>
										<option value="nm" selected>Near Mint</option>
										<option value="ex">Excellent</option>
										<option value="gd">Good</option>
										<option value="lp">Light Played</option>
										<option value="pl">Played</option>
										<option value="po">Poor</option>
									</select>

									<button type="submit" class="mt-1 text-sm bg-orange-300 rounded px-2">
										Ajouter
									</button>
								</form>
							</div>
						</div>
					{% endif %}
				</li>
			{% endfor %}
		</ul>
	</div>

{% endblock %}
