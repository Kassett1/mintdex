{% extends 'base.html.twig' %}

{% block title %}Hello SetPageController!
{% endblock %}

{% block body %}
	<div data-controller="wishlist" class="mx-5 md:mx-30 lg:mx-50 xl:mx-70 2xl:mx-100 3xl:mx-150">
		<img src="{{set.logo}}.webp" alt="{{set.name}}" class="mt-10 w-full h-auto px-10 md:px-20 lg:px-65 xl:px-75 2xl:px-90 3xl:px-120">

		<ul class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-2 2xl:gap-3 my-10">
			{% for card in cards %}
				<li class="relative">
					<a href="{{ path('app_card_page', { slug: card.slug }) }}">
						<img class="w-full" src="{{ card.image }}/low.webp" alt="{{ card.name }}">
					</a>

					{% if app.user %}
						<div class="flex absolute bottom-0 justify-between w-full items-end">
							<button class="w-6 h-6 2xl:w-8 2xl:h-8 rounded flex items-center justify-center transition {{ card.id in wishlistCards ? 'bg-pink-500/30' : 'bg-indigo-900/30' }} backdrop-blur-sm text-white shadow-md" data-action="click->wishlist#toggle" data-wishlist-card-id="{{ card.id }}" data-wishlist-initial-value="{{ card.id in wishlistCards ? 'true' : 'false' }}">
								<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="{{ card.id in wishlistCards ? 'currentColor' : 'none' }}" class="w-5 h-5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/>
								</svg>
							</button>

							{% set isOwned = card.id in ownedCards %}

							<div
								data-controller="add-card" data-add-card-is-owned-value="{{ isOwned ? 'true' : 'false' }}">

								<!-- Bouton -->
								<button type="button" data-action="click->add-card#toggle" class="w-6 h-6 2xl:w-8 2xl:h-8 rounded flex items-center justify-center transition backdrop-blur-sm text-white shadow-md
																											               {{ isOwned ? 'bg-green-500/30' : 'bg-orange-500/30' }}" data-add-card-target="button">
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-full h-full">

										{% if isOwned %}
											<path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
										{% else %}
											<path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/>
										{% endif %}

									</svg>
								</button>

								<!-- Popup -->
								<form data-add-card-target="form" data-action="submit->add-card#sendData" class="hidden fixed bottom-0 inset-x-5 md:inset-x-30 lg:inset-x-50 xl:inset-x-70 2xl:inset-x-100 3xl:inset-x-150 bg-white backdrop-blur-lg rounded-t-xl shadow-md p-4 translate-y-full transition-transform duration-300 ease-out z-50 grid-cols-2 gap-3 md:pb-40">
									<input
									type="hidden" name="cardId" value="{{ card.id }}">

									<!-- État -->
									<div>
										<label class="block text-xs font-inter mb-1 mx-1 text-violet-900">
											État
											<span class="text-red-500">*</span>
										</label>
										<select name="cardCondition" required class="text-sm font-inter w-full px-2 py-1 rounded-xl border border-violet-300 focus:outline-none focus:ring-2 focus:ring-violet-400 focus:border-violet-400">
											<option value="mt">Mint</option>
											<option value="nm" selected>Near Mint</option>
											<option value="ex">Excellent</option>
											<option value="gd">Good</option>
											<option value="lp">Light Played</option>
											<option value="pl">Played</option>
											<option value="po">Poor</option>
										</select>
									</div>

									<!-- Langue -->
									<div>
										<label class="block text-xs font-inter mb-1 mx-1 text-violet-900">
											Langue
											<span class="text-red-500">*</span>
										</label>
										<select name="language" required class="text-sm font-inter w-full px-2 py-1 rounded-xl border border-violet-300 focus:outline-none focus:ring-2 focus:ring-violet-400 focus:border-violet-400">
											<option value="fr">🇫🇷 Français</option>
											<option value="en">🇬🇧 Anglais</option>
											<option value="de">🇩🇪 Allemand</option>
											<option value="es">🇪🇸 Espagnol</option>
											<option value="it">🇮🇹 Italien</option>
											<option value="pt">🇵🇹 Portugais</option>
										</select>
									</div>

									<!-- Version -->
									<div>
										<label class="block text-xs font-inter mb-1 mx-1 text-violet-900">
											Version
											<span class="text-red-500">*</span>
										</label>
										<select name="version" required class="text-sm font-inter w-full px-2 py-1 rounded-xl border border-violet-300 focus:outline-none focus:ring-2 focus:ring-violet-400 focus:border-violet-400">
											<option value="normal">Normale</option>
											<option value="reverse">Reverse</option>
											<option value="holo">Holo</option>
											<option value="first">1ère édition</option>
										</select>
									</div>

									<!-- Estimation -->
									<div>
										<label class="block text-xs font-inter mb-1 mx-1 text-violet-900">
											Estimation
										</label>
										<input type="text" name="price" value="{{ card.getPrice() }}" class="text-sm font-inter w-full px-2 py-1 rounded-xl border border-violet-300 focus:outline-none focus:ring-2 focus:ring-violet-400 focus:border-violet-400"/>
									</div>

									<!-- Bouton -->
									<div class="w-full flex justify-center mt-2 col-span-2">
										<button type="submit" class="bg-violet-200 rounded-xl border border-violet-900 shadow-sm px-4 py-2 text-violet-900 font-sora text-sm">
											Ajouter
										</button>
									</div>

								</form>
							</div>
						</div>
					{% endif %}
				</li>
			{% endfor %}
		</ul>
	</div>

{% endblock %}
