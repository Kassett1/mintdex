{% extends 'base.html.twig' %}

{% block title %}Hello SearchPageController!
{% endblock %}

{% block body %}
	<div>
		<ul class="flex flex-row flex-wrap">
			{% for card in cards %}
				<li class="w-50">
					<a href="{{ path('app_card_page', { slug: card.slug }) }}"><img class="w-full" src="{{card.image}}/low.webp" alt="{{card.name}}"></a>
				</li>
			{% endfor %}
		</ul>
	</div>
{% endblock %}
