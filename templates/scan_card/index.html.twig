{% extends 'base.html.twig' %}

{% block title %}Hello ScanCardController!
{% endblock %}

{% block body %}
	<div class="max-w-md mx-auto p-4" data-controller="scan-card">

		<h1 class="text-lg font-semibold mb-2">Scanner une carte</h1>

		<!-- Caméra -->
		<video data-scan-card-target="video" autoplay playsinline class="w-full rounded bg-black"></video>

		<!-- Bouton scan -->
		<button data-action="click->scan-card#capture" class="w-full mt-3 bg-orange-300 rounded py-2 text-sm">
			Scanner la carte
		</button>

		<!-- Canvas caché -->
		<canvas data-scan-card-target="canvas" class="hidden"></canvas>

		<!-- Résultat -->
		<div data-scan-card-target="result" class="mt-3 text-sm"></div>

	</div>
{% endblock %}
