{% extends 'base.html.twig' %}

{% block title %}Hello ScanCardController!
{% endblock %}

{% block body %}
	<div class="max-w-md mx-auto p-4" data-controller="scan-card">

		<h1 class="text-lg font-semibold mb-2">Scanner</h1>

		<!-- Cadre caméra -->
		<div class="relative mx-auto w-full max-w-[300px] aspect-[0.72] overflow-hidden rounded-xl" data-scan-card-target="frame">
			<video data-scan-card-target="video" autoplay playsinline class="absolute inset-0 w-full h-full object-cover"></video>

			<!-- Coins avec marge -->
			<span class="absolute top-2 left-2 w-5 h-5 border-l-4 border-t-4 border-orange-400"></span>
			<span class="absolute top-2 right-2 w-5 h-5 border-r-4 border-t-4 border-orange-400"></span>
			<span class="absolute bottom-2 left-2 w-5 h-5 border-l-4 border-b-4 border-orange-400"></span>
			<span class="absolute bottom-2 right-2 w-5 h-5 border-r-4 border-b-4 border-orange-400"></span>
		</div>

		<!-- Bouton scan -->
		<button data-action="click->scan-card#capture" class="w-full mt-3 bg-orange-300 rounded py-2 text-sm">
			Scanner la carte
		</button>

		<!-- Canvas caché -->
		<canvas data-scan-card-target="canvas" class="hidden"></canvas>

		<!-- Debug -->
			<img data-scan-card-target="cropPreview" class="rounded border"/>
			<img data-scan-card-target="extractedName" class="rounded border"/>

		<!-- Résultat -->
		<div data-scan-card-target="result" class="mt-3 text-sm"></div>

	</div>
{% endblock %}
