{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!
{% endblock %}

{% block body %}
	<style>
		.example-wrapper {
			margin: 1em auto;
			max-width: 800px;
			width: 95%;
			font: 18px / 1.5 sans-serif;
		}
		.example-wrapper code {
			background: #F5F5F5;
			padding: 2px 6px;
		}
	</style>

	<div class="example-wrapper">
		<section>
			{% for bws in blocsWithSets|reverse %}
				<h2>{{ bws["bloc"].name|e }}<h2>

						<ul>
							{% for set in bws["sets"]|reverse %}

								<li>{{ set.name }}</li>

							{% endfor %}
						</ul>
					{% endfor %}
				</section>

				<ul></div>
			{% endblock %}
