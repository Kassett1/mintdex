{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!
{% endblock %}

{% block body %}
	<!-- Formulaire de recherche -->
	<form action="{{ path('app_search_page') }}" method="get" class="mt-10 mx-5 flex justify-center gap-2">
		<input type="text" name="q" placeholder="Rechercher une carte…" required class="rounded-xl border border-violet-100 shadow-sm focus:outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-300 text-sm px-2 lg:px-3 py-1 lg:py-2 lg:w-100 font-inter bg-white">
		<button type="submit" class="bg-violet-200 backdrop-blur-lg rounded-xl border border-violet-200 shadow-sm px-2 py-1 text-violet-900 font-sora text-sm">
			Rechercher
		</button>
	</form>

	<!-- Blocs avec sets -->
	<section class="mx-5 mt-5 flex flex-col gap-3 xl:gap-5 md:mx-30 lg:mx-50 xl:mx-70 2xl:mx-100 3xl:mx-150">
		{% for bws in blocsWithSets|reverse %}
			<div class="border-violet-100 shadow-sm rounded-xl p-2 lg:px-5 lg:py-3 lg:pb-5 bg-white">
				<h2 class="text-lg font-sora text-violet-900">{{ bws["bloc"].name|e }}</h2>

				<ul class="mt-5 lg:mt-5 grid grid-cols-10 md:grid-cols-12 lg:grid-cols-4 gap-3 lg:gap-3 2xl:gap-5 items-stretch">
					{% for set in bws["sets"]|reverse %}
						<li class="w-full lg:h-30 lg:bg-violet-50 lg:shadow-sm lg:rounded-xl lg:p-3">
							<a href="{{ path('app_set_page', { slug: set.slug }) }}" class="h-full flex flex-col items-center justify-center">
								<p class="hidden lg:block font-sora text-xs mb-3 text-center">{{ set.name }}</p>
								<img src="{{ set.symbol }}.webp" alt={{ set.name }} class="w-full h-auto lg:hidden"/>
								<img src="{{ set.logo }}.webp" alt={{ set.name }} class="w-auto h-full hidden lg:block"/>
							</a>
						</li>
					{% endfor %}
				</ul>
			</div>
		{% endfor %}
	</section>

{% endblock %}
