{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!
{% endblock %}

{% block body %}
	<!-- Formulaire de recherche -->
	<form action="{{ path('app_search_page') }}" method="get" class="">
		<input type="text" name="q" placeholder="Rechercher une carte…" required class="">
		<button type="submit" class="">
			Rechercher
		</button>
	</form>

	<!-- Blocs avec sets -->
	<section class="">
		{% for bws in blocsWithSets|reverse %}
			<div class="">
				<h2 class="">{{ bws["bloc"].name|e }}</h2>

				<ul class="">
					{% for set in bws["sets"]|reverse %}
						<li>
							<a href="{{ path('app_set_page', { slug: set.slug }) }}" class="">
								<img src="{{ set.symbol }}.webp" alt={{ set.name }}/>
							</a>
						</li>
					{% endfor %}
				</ul>
			</div>
		{% endfor %}
	</section>

</div>{% endblock %}
