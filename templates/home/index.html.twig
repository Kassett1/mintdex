{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!
{% endblock %}

{% block body %}

	<form action="{{ path('app_search_page') }}" method="get">
		<input type="text" name="q" placeholder="Rechercher une carte…" required>
		<button type="submit">Rechercher</button>
	</form>


	<div>
		<section>
			{% for bws in blocsWithSets|reverse %}
				<h2>{{ bws["bloc"].name|e }}<h2>

						<ul>
							{% for set in bws["sets"]|reverse %}

								<li>
									<a href="{{ path('app_set_page', { slug: set.slug }) }}">
										{{ set.name }}
									</a>
								</li>

							{% endfor %}
						</ul>
					{% endfor %}
				</section>

				<ul></div>
			{% endblock %}
