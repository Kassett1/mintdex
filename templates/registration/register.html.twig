{% extends 'base.html.twig' %}

{% block title %}Register
{% endblock %}

{% block body %}
	{% for flash_error in app.flashes('verify_email_error') %}
		<div class="alert alert-danger" role="alert">{{ flash_error }}</div>
	{% endfor %}

	<h1 class="mt-10 font-bricolage text-lg text-center">Créer un compte</h1>

	{{ form_errors(registrationForm) }}

	{{ form_start(registrationForm) }}
	<div class="flex border-violet-100 shadow-sm rounded-xl bg-white mx-5 md:mx-50 px-2 py-1 gap-2 mt-5">
		<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-violet-900">
			<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
		</svg>
		{{ form_widget(registrationForm.email, {
        attr: {
            placeholder: "Email",
            class: "font-inter text-sm ml-1 w-full rounded-xl outline-none focus:outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-300 px-1"
        }
        }) }}
	</div>

	<div class="flex border-violet-100 shadow-sm rounded-xl bg-white mx-5 md:mx-50 px-2 py-1 gap-2 mt-2">
		<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 text-violet-900">
			<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/>
		</svg>
		{{ form_widget(registrationForm.plainPassword, {
        attr: {
            placeholder: "Mot de passe",
            class: "font-inter text-sm ml-1 w-full rounded-xl outline-none focus:outline-none focus:ring-2 focus:ring-violet-300 focus:border-violet-300 px-1"
        }
        }) }}
	</div>

	{{ form_row(registrationForm.agreeTerms, {
        label: "Accepter les conditions",
        label_attr: {
            class: "font-inter text-xs text-violet-900"
        },
        attr: {
            class: "accent-violet-500 w-4 h-4 border-violet-100 shadow-sm rounded-xl"
        },
        row_attr: {
            class: "flex justify-center items-center gap-2 mt-2"
    }
    }) }}

	<button type="submit" class="bg-violet-200 backdrop-blur-lg rounded-xl border border-violet-200 shadow-sm px-2 py-1 text-violet-900 font-sora text-sm block mx-auto mt-5">
		Confirmer
	</button>
	{{ form_end(registrationForm) }}

{% endblock %}
